{
  "name": "three-king-solo-sanguosha",
  "version": "2.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:data": "node scripts/generate-data.mjs",
    "art:generals:preview": "node scripts/tune-general-images.mjs",
    "art:generals:apply": "node scripts/tune-general-images.mjs --apply",
    "art:generals:redraw-prompts": "node scripts/generate-general-redraw-prompts.mjs",
    "art:generals:apply-approved-samples": "node scripts/apply-approved-general-samples.mjs",
    "art:generals:apply-sheet": "node scripts/apply-generated-general-sheet.mjs",
    "art:generals:normalize-margins": "node scripts/normalize-general-card-margins.mjs",
    "start:dev": "node scripts/start-dev-server.mjs",
    "dev": "npm run prepare:data && vite --host 127.0.0.1 --port 7001 --strictPort",
    "build": "npm run prepare:data && tsc --noEmit && vite build",
    "deploy:cloudflare": "npm run build && wrangler pages deploy dist --project-name feimiaoduoni-ai-sanguosha",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "wrangler": "^4.90.1"
  }
}
